# =============================================================================
# anis-app — environment
#
# Copy to `.env` for local development. `.env` is gitignored and must never be
# committed. In production these are set on the OVH box as systemd
# `EnvironmentFile=` entries, owned by root with mode 0600 — not in this repo.
#
# PocketBase's OWN settings (SMTP credentials, S3 for file storage, app name)
# live in the PocketBase database and are edited in its admin UI, not here.
# What follows is only what our custom Go code and the deploy tooling read.
# =============================================================================

# -----------------------------------------------------------------------------
# Where each piece is served
# -----------------------------------------------------------------------------
# Used to build install snippets, escalation email links, and Stripe return
# URLs. In development the dashboard and widget run on Vite dev servers.
ANIS_API_URL=http://127.0.0.1:8090
ANIS_APP_URL=http://127.0.0.1:5173
ANIS_CDN_URL=http://127.0.0.1:5174

# Production values, for reference:
#   ANIS_API_URL=https://api.anis.chat
#   ANIS_APP_URL=https://app.anis.chat
#   ANIS_CDN_URL=https://cdn.anis.chat

# -----------------------------------------------------------------------------
# PocketBase
# -----------------------------------------------------------------------------
# Encrypts the settings stored in pb_data. Generate with:
#   openssl rand -hex 16          (must be exactly 32 hex characters)
# Losing this makes the stored settings unreadable — back it up separately from
# the database, or a restore gives you a database you cannot open.
PB_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# LLM — answer generation
# -----------------------------------------------------------------------------
# Anthropic is the default provider. Note for the privacy page: this means
# message text is processed in the United States, even though it is STORED in
# France. Say that plainly rather than implying end-to-end EU processing.
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Embeddings — Voyage AI
# -----------------------------------------------------------------------------
# Anthropic has no embeddings endpoint (their docs say so and point at Voyage),
# so this is a separate provider and a separate key.
#
# The whole voyage-4 series shares ONE embedding space: voyage-4-large,
# voyage-4, voyage-4-lite and voyage-4-nano produce interchangeable vectors.
# You can move between them without re-indexing — which is what makes both
# settings below safe to revisit later.
#
# voyage-4-nano is Apache-2.0 open weights that run on CPU. That is the path to
# offering a workspace embeddings that never leave France, against the same
# index. Not wired up yet.
VOYAGE_API_KEY=
ANIS_EMBEDDING_MODEL=voyage-4

# MUST equal the vec0 column width created by the migrations
# (migrations.EmbeddingDimensions). They are separate values on purpose: a
# mismatch should fail loudly at startup, not corrupt the index. Changing this
# means re-embedding every chunk in every workspace.
ANIS_EMBEDDING_DIMENSIONS=1024

# -----------------------------------------------------------------------------
# Billing
# -----------------------------------------------------------------------------
# Use test-mode keys locally. The webhook secret comes from
# `stripe listen --forward-to 127.0.0.1:8090/api/anis/stripe/webhook`, and is
# DIFFERENT from the one shown in the Stripe dashboard for the deployed
# endpoint — mixing them up produces silent signature failures.
#
# Leaving these unset is fine: billing endpoints report that they are
# unavailable and the rest of the product runs normally.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# IMPORTANT — the webhook endpoint's API version must match the SDK's.
#
# stripe-go v86 pins API version 2026-07-29.dahlia and REFUSES an event from a
# different release train, so a webhook endpoint created on an older version
# makes every single delivery fail verification. That failure reads exactly
# like a wrong signing secret, which sends you looking in the wrong place.
# Create the endpoint with a matching version, and re-check it whenever the
# SDK is upgraded.

# Stripe price ids, one per paid plan. These differ between test and live
# mode, which is why they are configuration rather than constants — a build
# that only works in one mode cannot be rehearsed in the other.
#
# An unrecognised price is deliberately mapped to NO plan: guessing would
# either give away a paid tier or downgrade a paying customer.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=

# -----------------------------------------------------------------------------
# Crawler
# -----------------------------------------------------------------------------
# Sent as User-Agent when fetching a customer's website, so site owners can
# identify and rate-limit us. Keep the contact URL reachable.
ANIS_CRAWLER_USER_AGENT=AnisBot/1.0 (+https://anis.chat/bot)

# Per-crawl page limits come from the plan (plans.PagesPerCrawl), not from here.

# -----------------------------------------------------------------------------
# Development-only escape hatches
# -----------------------------------------------------------------------------
# Both MUST be unset in production. Each logs a warning on every startup, and
# each is gated on an explicit value rather than on "a key is missing" —
# because a missing key in production is exactly when a silent fallback would
# do the most damage.
#
# ANIS_DEV_FAKE_EMBEDDINGS=1
#   Replaces Voyage with a hashed bag of words so the app runs with no API key.
#   It has NO semantic understanding: it cannot match a question to a
#   differently-worded answer, which is the entire job of an embedding model.
#   Retrieval quality under it is meaningless. Chunks embedded with it are
#   stamped DEV-FAKE-EMBEDDINGS-NOT-FOR-PRODUCTION, so if it ever runs against
#   real data the evidence is in the database rather than only in a log.
#
# ANIS_ALLOW_PRIVATE_CRAWL=1
#   Removes the crawler's SSRF guard so it can reach 127.0.0.1 fixtures. In
#   production this would let any customer point the crawler at
#   169.254.169.254 and read the machine's cloud credentials back out of their
#   own knowledge base.

# -----------------------------------------------------------------------------
# Backups (Litestream → OVH Object Storage)
# -----------------------------------------------------------------------------
# Read by deploy/litestream.yml on the server. Not needed for local dev.
# Create a dedicated S3 user with write-only access to the backup bucket: these
# credentials sit on the same box as the data they protect, so an attacker who
# reaches them should not also be able to delete the backups.
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
