# Keep node_modules strict: a package may only import what it declares. This is
# the main reason to use pnpm at all, and turning it off to fix one broken
# dependency hides every other undeclared import in the repo.
shamefully-hoist=false
node-linker=isolated

# Workspace packages resolve to the local source, not the registry. Without
# this, `@anis/tokens` in an app would try to download a package that does not
# exist publicly.
link-workspace-packages=true
prefer-workspace-packages=true

# Do NOT auto-install peer dependencies. When a peer is missing we want the
# install to say so, so it gets added deliberately with a version we chose.
auto-install-peers=false
strict-peer-dependencies=false

# Reproducible CI installs.
resolution-mode=highest
