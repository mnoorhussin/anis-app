{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [".env", "packages/config/tsconfig/*.json"],
  "globalEnv": ["NODE_ENV", "CI"],

  "globalPassThroughEnv": [
    "LOCALAPPDATA",
    "APPDATA",
    "USERPROFILE",
    "HOME",
    "GOROOT",
    "GOPATH",
    "GOCACHE",
    "GOMODCACHE"
  ],

  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.ts", "!**/*.test.tsx"],
      "outputs": ["dist/**", "anis", "anis.exe"],
      "env": ["VITE_*", "ANIS_*"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": []
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },
    "generate": {
      "cache": false
    }
  }
}
